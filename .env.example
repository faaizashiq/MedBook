# Supabase Cloud Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT & Security
JWT_SECRET="your-secret-jwt-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Nodemailer / SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"
EMAIL_FROM_NAME="MedBook"

# Automated Cron & Reminders Security
CRON_SECRET="your_cron_secret_key"

# Telehealth Video Consultation (Defaults to meet.ffrn.de)
NEXT_PUBLIC_JITSI_DOMAIN="meet.ffrn.de"
